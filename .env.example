# ToolNet Drama API Gateway — operator template.
# Copy to .env and fill secrets. NEVER commit real keys.

# --- Upstream RapidAPI ReelShort ---
RAPIDAPI_REELSHORT_HOST=reelshort-short-drama-api.p.rapidapi.com
RAPIDAPI_REELSHORT_KEY_1=replace-with-real-key-1
RAPIDAPI_REELSHORT_KEY_2=replace-with-real-key-2
RAPIDAPI_REELSHORT_ENABLED=true

# Upstream operation paths — set ONLY from real RapidAPI docs / Code Snippet.
# See docs/RAPIDAPI_ENDPOINTS.md for exactly what to paste here.
# VERIFIED 2026-10-13 (official RapidAPI cURL): GetEpisode:
RAPIDAPI_REELSHORT_EPISODES_PATH=/reelshort/series/{id}/episodes/{episode_id}
# Validation fixture for Connection Test (one live request per test run):
RAPIDAPI_REELSHORT_TEST_SERIES_ID=6a7619d41dcbbd8e12015bfe
RAPIDAPI_REELSHORT_TEST_EPISODE_ID=8giu100fn0
# While empty, /v1/* serves local SQLite metadata labelled live:false and any
# live-upstream call fails with UPSTREAM_NOT_VERIFIED (no endpoint guessing).
# Supported placeholders: {id} = series/book id, {episode_id} = episode/chapter id.
# Example shape (illustrative only — DO NOT use without docs verification):
# RAPIDAPI_REELSHORT_SEARCH_PATH=/search?query={q}
RAPIDAPI_REELSHORT_SEARCH_PATH=
RAPIDAPI_REELSHORT_DETAIL_PATH=
RAPIDAPI_REELSHORT_EPISODES_PATH=
UPSTREAM_TIMEOUT_S=8
UPSTREAM_MAX_RETRIES=1

# --- Gateway ---
# Master key for encrypted upstream connection storage (Fernet). Generate once:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOLNET_MASTER_KEY=replace-with-generated-fernet-key
ALLOW_VIDEO_URLS=false
RATE_LIMIT_DEFAULT_RPM=60
CACHE_TTL_SEARCH_S=300
CACHE_TTL_DETAIL_S=3600
CACHE_TTL_EPISODE_S=600
POOL_STRATEGY=round_robin
POOL_ROTATION_ENABLED=true
POOL_COOLDOWN_S=300
DB_PATH=/home/ubuntu/api-drama/data/reelshort.sqlite3
LOG_FILE=/home/ubuntu/api-drama/logs/api-drama.log
GATEWAY_PORT=8090

# --- Owner admin (dashboard at /admin; no customer accounts exist) ---
# Bootstrap: set once to create the first owner, log in, then REMOVE
# ADMIN_PASSWORD from .env. Additional owners via dashboard or:
# .venv/bin/python tools/create_admin.py --username owner2
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_H=12
# Set true when served behind HTTPS reverse proxy (Secure cookie flag).
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_S=600

# --- Database: Layerbase (libSQL) or local SQLite ---
# Set DATABASE_URL to libsql://... to use Layerbase/Turso for main DB.
# If empty or not libsql://, falls back to local SQLite at DB_PATH.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Persistent Episode Cache (Turso / libSQL) --- see docs/EPISODE_CACHE.md
# OFF unless EPISODE_CACHE_ENABLED=true AND both TURSO_* values are set. Never commit real values.
EPISODE_CACHE_ENABLED=false
EPISODE_CACHE_BACKEND=turso
# Use the exact libsql:// URL printed by `turso db show drama-cache --url` (AWS ap-southeast-2).
TURSO_DATABASE_URL=
# `turso db tokens create drama-cache` (prefer a scoped/expiring token). NEVER log or commit.
TURSO_AUTH_TOKEN=
EPISODE_METADATA_TTL_SECONDS=2592000
EPISODE_VIDEO_URL_TTL_SECONDS=86400
# Per-provider override, e.g. EPISODE_VIDEO_URL_TTL_SECONDS_REELSHORT=43200
EPISODE_CACHE_TIMEOUT_SECONDS=5
EPISODE_CACHE_MAX_RETRIES=2
EPISODE_CACHE_POOL_SIZE=3
# true = if Turso is down, keep serving customers from upstream (auth/quota still enforced).
EPISODE_CACHE_FALLBACK_TO_UPSTREAM=true
EPISODE_CACHE_LOCK_LEASE_SECONDS=60
EPISODE_CACHE_LOCK_WAIT_SECONDS=20
EPISODE_CACHE_FLUSH_INTERVAL_SECONDS=30
# auto = persist video URLs only while ALLOW_VIDEO_URLS=true; true/false to force.
EPISODE_CACHE_STORE_VIDEO_URL=auto
# Honour upstream Cache-Control (no-store/no-cache/private => not cached; max-age caps TTLs).
EPISODE_CACHE_RESPECT_CACHE_CONTROL=true

